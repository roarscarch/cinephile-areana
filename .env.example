# ── Cinephiles Areana — environment template ──
# Copy to .env.local and fill in real values.
# Get the public TMDB key at https://www.themoviedb.org/settings/api
#
# PEACHIFY_KEY_HEX and VIDNEST_ALPHABET are operator-supplied deploy-time
# values; provide them in .env.local (or your deploy env) before starting.
# ──────────────────────────────────────────────

# TMDB v3 API key. A low-privilege read key is enough.
TMDB_API_KEY=""

# AES-256-GCM key (hex, 64 hex chars) used to decrypt Peachify payloads.
PEACHIFY_KEY_HEX=""

# Custom base64 alphabet (44-char, URL-safe variant) used to decode Vidnest payloads.
VIDNEST_ALPHABET=""

# ── Optional overrides ────────────────────────
PORT=3000                # default: 3000
TMDB_BASE_URL=https://api.themoviedb.org   # override for proxies

# Option A: set on Vercel so /play 302-redirects to the Cloudflare Worker
# instead of proxying video bytes (saves Fast Origin Transfer).
# Unset locally / on VPS to proxy directly.
# PLAY_PROXY_BASE="https://cinephile-play.cinephilia-areana.workers.dev"

# Hotlink protection: shared secret for signing /play URLs (same value on
# Vercel, Pages, and the Worker). Generate: openssl rand -hex 32
# PLAY_SIGNING_KEY=""

# Extra origins allowed to mint signatures via /sign (comma-separated).
# ALLOW_ORIGINS=""
